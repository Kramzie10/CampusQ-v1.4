@page "{ticketNumber:int}"
@model CampusQ.Web.Pages.Ticket.IndexModel
@using CampusQ.Web.Services
@{
    ViewData["Title"] = "Ticket Status";
}

<div class="d-flex justify-content-center">
    <div class="card shadow-sm mt-4" style="max-width: 480px; width: 100%;" id="ticket-card"
         data-ticket-number="@Model.Status.TicketNumber" data-refresh-seconds="@Model.RefreshIntervalSeconds">

        @if (Model.Status.State == TicketState.NotFound)
        {
            <div class="card-body text-center">
                <h3 class="card-title text-danger">Ticket Not Found</h3>
                <p class="text-muted">We couldn't find ticket #@Model.Status.TicketNumber. Please check the QR code and try again.</p>
            </div>
        }
        else if (Model.Status.State == TicketState.Served)
        {
            <div class="card-body text-center">
                <h3 class="card-title text-success">Ticket Served</h3>
                <p class="display-6" id="ticket-label">@Model.Status.TicketLabel</p>
                <p class="text-muted">@Model.Status.Service — @Model.Status.Purpose</p>
                <p class="text-muted">This ticket has already been served@(Model.Status.ServedAt.HasValue ? $" at {Model.Status.ServedAt:hh:mm tt}" : "").</p>
            </div>
        }
        else
        {
            <div class="card-body text-center">
                <h3 class="card-title">Your Ticket</h3>
                <p class="display-4 fw-bold" id="ticket-label">@Model.Status.TicketLabel</p>
                <p class="text-muted mb-4" id="ticket-service">@Model.Status.Service — @Model.Status.Purpose</p>

                <div class="row text-center">
                    <div class="col-6 border-end">
                        <div class="fs-2 fw-bold" id="people-ahead">@Model.Status.PeopleAhead</div>
                        <div class="text-muted small">People ahead of you</div>
                    </div>
                    <div class="col-6">
                        <div class="fs-2 fw-bold" id="estimated-wait">@Model.Status.EstimatedWaitMinutes min</div>
                        <div class="text-muted small">Estimated wait time</div>
                    </div>
                </div>

                <p class="text-muted mt-4 small">This page refreshes automatically every @Model.RefreshIntervalSeconds seconds.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var card = document.getElementById('ticket-card');
            if (!card) return;
            var ticketNumber = card.getAttribute('data-ticket-number');
            var refreshSeconds = parseInt(card.getAttribute('data-refresh-seconds'), 10) || 10;

            function refreshStatus() {
                fetch('/api/ticket/' + ticketNumber + '/status')
                    .then(function (resp) { return resp.json(); })
                    .then(function (data) {
                        var peopleAhead = document.getElementById('people-ahead');
                        var estimatedWait = document.getElementById('estimated-wait');
                        if (peopleAhead) peopleAhead.textContent = data.peopleAhead;
                        if (estimatedWait) estimatedWait.textContent = data.estimatedWaitMinutes + ' min';

                        // If the ticket state changed (e.g. now served/not found), reload for the correct view.
                        if (data.state !== 1) {
                            location.reload();
                        }
                    })
                    .catch(function () { /* ignore transient network errors */ });
            }

            setInterval(refreshStatus, refreshSeconds * 1000);
        })();
    </script>
}
